# ── Public client configuration (bundled into the browser; never put secrets here) ──
# Supabase project URL and publishable/anon key. Required.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional display name override (the default is ChatSpace).
VITE_APP_NAME=ChatSpace

# Web Push public key (VAPID). Required only for browser push notifications.
# Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Optional LiveKit Cloud / self-hosted signalling URL. The livekit-token Edge
# Function returns the URL it is configured with, so this is informational only.
VITE_LIVEKIT_URL=

# NEVER put any of these in .env or in client code:
#   SUPABASE_SERVICE_ROLE_KEY, VAPID_PRIVATE_KEY, TURN_SECRET,
#   LIVEKIT_API_KEY, LIVEKIT_API_SECRET, PUSH_WEBHOOK_SECRET
# Set them as Supabase Edge Function secrets instead:
#   supabase secrets set NAME=value
# See docs/DEPLOYMENT.md for the complete list and setup order.
